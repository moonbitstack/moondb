// moonsqls: SQL Server under the moondb contract, over TDS. Prelogin negotiates
// encryption, login7 carries the credentials, and every statement that follows is
// either a SQL batch or an RPC to sp_executesql — the token stream coming back is parsed
// here rather than through a client library.
supported_targets = "+native+wasm"

import {
  "moonbitstack/moondb",
  "moonbitstack/moontls/tls",
  "moonbitstack/mooncred/x509",
  "moonbitstack/moonvar/fixed",
  "moonbitlang/async/io",
  "moonbitlang/async/socket",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/encoding/utf16",
  "moonbitlang/core/env",
}

import {
  "moonbitlang/async",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
  "moonbitstack/moondb/conformance",
} for "wbtest"
