// moonduckdb: the embedded analytical engine behind the moondb contract. `DuckdbDriver`
// implements `@moondb.Driver` over DuckDB's C API, so a query layer written for SQLite or
// PostgreSQL runs on a columnar store unchanged.
//
// The engine is not compiled into this package. On native a twenty-megabyte C++
// amalgamation would be; the stub loads the released shared library at run time instead, and
// `MOONDUCKDB_LIBRARY` names it when the default search does not find it. On js the engine
// is DuckDB's own WebAssembly build, fetched before the run by `scripts/fetch_engine.sh`.
// Either way this package stays one small source tree and the engine stays a thing the
// machine already has.
//
// `-unused_package` is off because `moonbitlang/async/js_async` is imported for the js files
// only, and a native check has no file that can use it.
//
// Two targets: wasm and wasm-gc have neither a shared library to load nor a module to
// instantiate.
supported_targets = "+native+js"

warnings = "-unused_package"

import {
  "moonbitstack/moondb",
  "moonbitlang/async/js_async",
  "moonbitlang/core/encoding/utf8",
}

options(
  "native-stub": [ "duckdb/stub.c" ],
  targets: {
    "ffi_native.mbt": [ "native" ],
    "ffi_js.mbt": [ "js" ],
    "open_native.mbt": [ "native" ],
    "open_js.mbt": [ "js" ],
    "conformance_test.mbt": [ "native" ],
    "duckdb_test.mbt": [ "native" ],
    "wasm_test.mbt": [ "js" ],
    "wasm_conformance_test.mbt": [ "js" ],
  },
)

import {
  "moonbitlang/async",
  "moonbitstack/moondb/conformance",
} for "test"
