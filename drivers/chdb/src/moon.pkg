// moonchdb: a ClickHouse driver over the server's HTTP interface. The wire is
// HTTP/1.1 with the query in the body and the parameters in the URL, the result is
// `RowBinaryWithNamesAndTypes` (exact, no text formatting in between), and the
// connection is stateless — every statement is one request on its own socket.
supported_targets = "+native+wasm"

import {
  "moonbitstack/moondb",
  "moonbitstack/moonvar/fixed",
  "moonbitlang/async/io",
  "moonbitlang/async/socket",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/string",
}

import {
  "moonbitlang/async",
  "moonbitlang/core/env",
  "moonbitstack/moondb/conformance",
} for "test"

import {
  "moonbitlang/async",
} for "wbtest"
